# Copy to .env and fill in. Only this example file is committed; .env is git-ignored.

# PostgreSQL
POSTGRES_DB=vacancy_tracker
POSTGRES_USER=vacancy
POSTGRES_PASSWORD=change-me

# Application profile: local (no auth, binds to 127.0.0.1) or vps (access token required)
SPRING_PROFILES_ACTIVE=local

# Job sources (optional; a source without its settings does nothing)
# Greenhouse / Lever / Ashby: comma-separated board tokens, site slugs and board names
APP_SOURCES_GREENHOUSE_BOARDS=
APP_SOURCES_LEVER_SITES=
APP_SOURCES_ASHBY_BOARDS=
# Adzuna: free keys from developer.adzuna.com; countries and currencies are configured by you
APP_SOURCES_ADZUNA_APP_ID=
APP_SOURCES_ADZUNA_APP_KEY=
APP_SOURCES_ADZUNA_COUNTRIES=
APP_SOURCES_ADZUNA_CURRENCIES=
# Himalayas: optional key for higher limits
APP_SOURCES_HIMALAYAS_API_KEY=
