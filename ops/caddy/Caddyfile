# Reverse proxy for the vps deployment (T-075, docs/deployment.md). Caddy gets and renews the HTTPS certificate for
# DOMAIN by itself and passes requests to the app, adding X-Forwarded-For and X-Forwarded-Proto, which the app uses
# for the login rate limit and the Secure cookie. DOMAIN comes from .env; "localhost" gives a local test certificate.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The UI is a same-origin bundle: module script from /assets, no external fonts, hosts or inline scripts.
		# Inline styles are allowed (Preact style attributes); data: images cover inline icons.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Uploads are capped at 5 MB in the app (resume, .eml); 10 MB leaves room for multipart overhead.
	request_body {
		max_size 10MB
	}

	# flush_interval -1 sends server-sent events (the Refresh progress) at once instead of buffering them.
	reverse_proxy app:8080 {
		flush_interval -1
	}
}
