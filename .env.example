# Copy to .env and fill in. Only this example file is committed; .env is git-ignored.

# PostgreSQL
POSTGRES_DB=vacancy_tracker
POSTGRES_USER=vacancy
POSTGRES_PASSWORD=change-me

# Application profile: local (no auth, binds to 127.0.0.1) or vps (access token required)
SPRING_PROFILES_ACTIVE=local
# Required when SPRING_PROFILES_ACTIVE=vps: at least 16 characters, for example from `openssl rand -base64 32`.
# The app refuses to start in the vps profile without it. Never commit the real value.
APP_ACCESS_TOKEN=
# Wrong tokens allowed per client address before it is blocked, and how long the block lasts (minutes)
APP_AUTH_MAX_FAILURES=5
APP_AUTH_FAILURE_WINDOW_MINUTES=10

# Job sources (optional; a source without its settings does nothing)
# Greenhouse / Lever / Ashby: comma-separated board tokens, site slugs and board names
APP_SOURCES_GREENHOUSE_BOARDS=
APP_SOURCES_LEVER_SITES=
APP_SOURCES_ASHBY_BOARDS=
# Adzuna: free keys from developer.adzuna.com; countries and currencies are configured by you
APP_SOURCES_ADZUNA_APP_ID=
APP_SOURCES_ADZUNA_APP_KEY=
APP_SOURCES_ADZUNA_COUNTRIES=
APP_SOURCES_ADZUNA_CURRENCIES=
# Himalayas: optional key for higher limits
APP_SOURCES_HIMALAYAS_API_KEY=

# Email alerts via IMAP (optional; off unless enabled). Use a dedicated folder or label for job alert emails,
# and an app password, never your main password. The tool only reads; it deletes and moves nothing.
APP_MAIL_IMAP_ENABLED=false
APP_MAIL_IMAP_HOST=
APP_MAIL_IMAP_PORT=993
APP_MAIL_IMAP_SSL=true
APP_MAIL_IMAP_USERNAME=
APP_MAIL_IMAP_PASSWORD=
APP_MAIL_IMAP_FOLDER=Job alerts
# true flags handled messages on the server with the user flag VacancyTrackerProcessed (opens the folder read-write)
APP_MAIL_IMAP_MARK_PROCESSED=false
APP_MAIL_IMAP_MAX_PER_RUN=50
# Only mail received in the last N days is looked at (the server searches by date, older mail is never fetched). 0 = no limit.
APP_MAIL_IMAP_MAX_AGE_DAYS=14

# Telegram digest (optional; off unless enabled). After a collection run, one message lists new matches at or
# above each profile's notifyMinScore: title, company, place, score and link. Create a bot with @BotFather.
APP_NOTIFICATIONS_TELEGRAM_ENABLED=false
APP_NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
APP_NOTIFICATIONS_TELEGRAM_CHAT_ID=
APP_NOTIFICATIONS_TELEGRAM_MAX_ITEMS=10
APP_NOTIFICATIONS_TELEGRAM_MAX_AGE_DAYS=3

# Backups (docker compose service "backup"; see docs/operations.md)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# VPS deployment with HTTPS (docker-compose.vps.yml, docs/deployment.md)
# The host name that points at this server. Caddy gets the certificate for it.
DOMAIN=

# Optional tuning (every value below is the built-in default; uncomment to change)
# Collection schedule (Spring cron, six fields) and how many successful runs without a sighting expire a vacancy
# APP_COLLECTION_CRON=0 0 6,18 * * *
# APP_COLLECTION_EXPIRY_RUNS=3
# Exchange-rate refresh (ECB): schedule, time zone, address, and whether to refresh at start-up
# APP_RATES_CRON=0 30 16 * * MON-FRI
# APP_RATES_ZONE=Europe/Berlin
# APP_RATES_REFRESH_ON_STARTUP=true
# Score bonus for an allowlisted company
# APP_MATCHING_ALLOWLIST_BONUS=10
# Search words and page limits of the sources that take them
# APP_SOURCES_ADZUNA_WHAT=
# APP_SOURCES_ADZUNA_MAX_PAGES=1
# APP_SOURCES_JOBICY_TAG=
# APP_SOURCES_REMOTIVE_SEARCH=
# APP_SOURCES_ARBEITNOW_MAX_PAGES=3
# APP_SOURCES_HIMALAYAS_MAX_PAGES=3
# Import by URL refuses private network addresses; set true only on a machine where reading them is the point
# APP_IMPORT_ALLOW_PRIVATE_HOSTS=false
# Ports of the Caddy proxy in docker-compose.vps.yml
# HTTP_PORT=80
# HTTPS_PORT=443
